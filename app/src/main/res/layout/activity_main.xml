<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/numberField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_number"
        android:inputType="phone"
        android:layout_marginBottom="14dp" />

    <EditText
        android:id="@+id/teluguField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_telugu"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:maxLines="4" />

    <Button
        android:id="@+id/teluguButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_telugu"
        android:layout_marginBottom="14dp" />

    <EditText
        android:id="@+id/hindiField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_hindi"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:maxLines="4" />

    <Button
        android:id="@+id/hindiButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_hindi"
        android:layout_marginBottom="14dp" />

    <EditText
        android:id="@+id/englishField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_english"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:maxLines="4" />

    <Button
        android:id="@+id/englishButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_english"
        android:layout_marginBottom="14dp" />

    <Button
        android:id="@+id/closeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_close"
        style="?android:attr/buttonBarButtonStyle" />

</LinearLayout>
</ScrollView>
